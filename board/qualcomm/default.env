stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=if test "${reboot-mode}" = "bootloader"; then run fastboot; fi
fastboot=fastboot -l $fastboot_addr_r usb 0
do_boot=setenv bootargs root=PARTLABEL=rootfs rw rootwait console=ttyMSM0,115200 arm-smmu.disable_bypass=0 clk_ignore_unused pd_ignore_unused deferred_probe_timeout=30; fatload mmc 0:41 ${kernel_addr_r} Image; fatload mmc 0:41 ${fdt_addr_r} qrb2210-arduino-imola-base.dtb; booti ${kernel_addr_r} - ${fdt_addr_r}
bootmenu_0=Boot Arduino UNO Q=run do_boot
bootmenu_1=Enable fastboot mode=run fastboot
bootmenu_2=Reset device=reset
menucmd=bootmenu
bootcmd=run do_boot
